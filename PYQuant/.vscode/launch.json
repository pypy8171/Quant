{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "pytest — strategy_a",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/test_strategy_a.py", "-v"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "pytest — indicators",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/test_indicators.py", "-v"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "pytest — 전체",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/", "-v"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "backtest (2022~2023 학습)",
            "type": "debugpy",
            "request": "launch",
            "module": "main",
            "args": ["backtest", "--from", "2022-01-01", "--to", "2023-12-31"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "live (DRY RUN)",
            "type": "debugpy",
            "request": "launch",
            "module": "main",
            "args": ["live", "--dry-run"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
