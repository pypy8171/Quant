    {
      "id": 18,
      "type": "table",
      "title": "지금 실행 중인 DB 쿼리 (pg_stat_activity)",
      "description": "idle이 아닌 세션 — 오래 도는 쿼리·잠금 대기(wait_event)를 여기서 본다",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 70
      },
      "datasource": {
        "type": "postgres",
        "uid": "tsdb"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "tsdb"
          },
          "format": "table",
          "rawSql": "SELECT pid, application_name AS \"앱\", state AS \"상태\", wait_event_type AS \"대기 유형\", wait_event AS \"대기\", ROUND(EXTRACT(EPOCH FROM NOW() - query_start)::numeric, 1) AS \"경과 초\", LEFT(regexp_replace(query, '\\s+', ' ', 'g'), 140) AS \"쿼리\" FROM pg_stat_activity WHERE datname = current_database() AND state <> 'idle' AND pid <> pg_backend_pid() ORDER BY query_start;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
