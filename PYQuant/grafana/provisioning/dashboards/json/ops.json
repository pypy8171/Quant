    {
      "id": 17,
      "type": "table",
      "title": "DB 부하 상위 쿼리 (pg_stat_statements, 서버 기동 후 누적)",
      "description": "쿼리 모양별 누적 실행 시간 상위 15개. 그라파나 자신의 조회는 뺀다. 초기화: SELECT pg_stat_statements_reset();",
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 58
      },
      "datasource": {
        "type": "postgres",
        "uid": "tsdb"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "tsdb"
          },
          "format": "table",
          "rawSql": "SELECT LEFT(regexp_replace(query, '\\s+', ' ', 'g'), 110) AS \"쿼리\", calls AS \"호출\", ROUND(total_exec_time::numeric, 0) AS \"누적 ms\", ROUND(mean_exec_time::numeric, 2) AS \"평균 ms\", rows AS \"행\", ROUND(blk_read_time::numeric, 0) AS \"디스크 읽기 ms\" FROM pg_stat_statements WHERE dbid = (SELECT oid FROM pg_database WHERE datname = current_database()) AND query NOT ILIKE '%pg_stat_%' AND query NOT ILIKE '%time_bucket%' ORDER BY total_exec_time DESC LIMIT 15;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "누적 ms"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
