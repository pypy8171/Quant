        "y": 10
      },
      "datasource": {
        "type": "postgres",
        "uid": "tsdb"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "tsdb"
          },
          "format": "time_series",
          "rawSql": "SELECT NOW() AS time, COUNT(*) AS restarts FROM (\n  SELECT data_cnt - LAG(data_cnt) OVER (ORDER BY ts) AS d\n  FROM health WHERE ts::date = CURRENT_DATE) s WHERE d < 0;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
