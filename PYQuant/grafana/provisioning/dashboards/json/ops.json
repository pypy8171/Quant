    {
      "id": 21,
      "type": "timeseries",
      "title": "구간 지연 p50 (기동 후 누적 분포)",
      "description": "주문 하나가 지나는 네 구간. 틱 수신→신호, 신호→주문 큐 pop, pop→주문 반환(게이트+KIS 왕복), 전체. 표본은 첫 시도 주문만(재시도 제외)이고 히스토그램 칸 상한이라 참값보다 최대 12% 크다.",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 88
      },
      "datasource": {
        "type": "postgres",
        "uid": "tsdb"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "tsdb"
          },
          "format": "time_series",
          "rawSql": "SELECT ts AS time, NULLIF(tick_to_signal_p50_us, -1) AS \"틱→신호\", NULLIF(signal_to_pop_p50_us, -1) AS \"신호→주문 큐 pop\", NULLIF(pop_to_done_p50_us, -1) AS \"pop→주문 반환\", NULLIF(total_p50_us, -1) AS \"전체\" FROM health WHERE $__timeFilter(ts) AND latency_samples > 0 ORDER BY ts;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "µs",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2
          }
        },
        "overrides": []
      }
