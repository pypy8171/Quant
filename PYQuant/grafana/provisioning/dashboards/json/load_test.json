      "panels": []
    },
    {
      "type": "stat",
      "title": "초당 체결 (직전 10초 평균)",
      "datasource": {
        "type": "postgres",
        "uid": "tsdb"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "tsdb"
          },
          "format": "time_series",
          "rawSql": "SELECT NOW() AS time, COUNT(*)::float / 10 AS v FROM ticks WHERE ts > NOW() - INTERVAL '10 seconds';",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
