    {
      "type": "timeseries",
      "title": "표별 초당 적재 — 체결이 원장·주문까지 갔는지",
      "datasource": {
        "type": "postgres",
        "uid": "tsdb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "tsdb"
          },
          "format": "time_series",
          "rawSql": "SELECT time_bucket('1 second', ts) AS time, '체결(ticks)' AS metric, COUNT(*) AS value FROM ticks WHERE $__timeFilter(ts) GROUP BY 1 UNION ALL SELECT time_bucket('1 second', ts), '신호(signals)', COUNT(*) FROM signals WHERE $__timeFilter(ts) GROUP BY 1 UNION ALL SELECT time_bucket('1 second', ts), '주문(orders)', COUNT(*) FROM orders WHERE $__timeFilter(ts) GROUP BY 1 UNION ALL SELECT time_bucket('1 second', ts), '체결통보(fills)', COUNT(*) FROM fills WHERE $__timeFilter(ts) GROUP BY 1 ORDER BY 1;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "always",
            "pointSize": 6
