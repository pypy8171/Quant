      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "tsdb"
          },
          "format": "table",
          "rawSql": "SELECT ticker AS \"종목\", COUNT(*) AS \"체결 건수\", SUM(volume) AS \"체결 수량\", MIN(price) AS \"최저가\", MAX(price) AS \"최고가\", MAX(ts) AS \"마지막 체결\" FROM ticks WHERE $__timeFilter(ts) GROUP BY 1 ORDER BY 2 DESC LIMIT 30;",
          "refId": "A"
        }
