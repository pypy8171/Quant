    {
      "type": "stat",
      "title": "마지막 체결 이후 흐른 시간",
      "datasource": {
        "type": "postgres",
        "uid": "tsdb"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
