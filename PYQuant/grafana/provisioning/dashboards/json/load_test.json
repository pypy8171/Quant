          "datasource": {
            "type": "postgres",
            "uid": "tsdb"
          },
          "format": "time_series",
          "rawSql": "SELECT time_bucket('1 second', ts) AS time, SUM(price * volume) AS \"체결대금/초\" FROM ticks WHERE $__timeFilter(ts) GROUP BY 1 ORDER BY 1;",
