    {
      "type": "timeseries",
      "title": "초당 체결 건수 — 1초 단위 (동시호가 한 방·연속매매 60초가 여기 보인다)",
      "datasource": {
        "type": "postgres",
        "uid": "tsdb"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "tsdb"
          },
          "format": "time_series",
          "rawSql": "SELECT time_bucket('1 second', ts) AS time, COUNT(*) AS \"체결/초\" FROM ticks WHERE $__timeFilter(ts) GROUP BY 1 ORDER BY 1;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "always",
            "pointSize": 6
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "초당 체결대금 (원)",
      "datasource": {
        "type": "postgres",
        "uid": "tsdb"
