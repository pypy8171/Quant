    {
      "type": "timeseries",
      "title": "큐 사용률 (%) — 100에 붙으면 뒤가 못 따라가는 것이다",
      "datasource": {
        "type": "postgres",
        "uid": "tsdb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
