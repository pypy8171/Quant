        },
        {
            "name": "🔍 백테스팅 (2025 전체)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/PYQuant/main.py",
            "cwd": "${workspaceFolder}/PYQuant",
            "args": ["backtest", "--from", "2025-01-01", "--to", "2025-12-31", "--pbr", "1.0"],
            "console": "integratedTerminal"
        },
        {
            "name": "📈 실전매매 (DRY RUN)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/PYQuant/main.py",
            "cwd": "${workspaceFolder}/PYQuant",
            "args": ["live", "--dry-run", "--pbr", "1.0"],
            "console": "integratedTerminal"
