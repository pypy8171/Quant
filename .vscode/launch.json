            "args": ["${workspaceFolder}/Quant/config/config.json"],
            "cwd": "${workspaceFolder}/Quant/build_win",
            "console": "integratedTerminal",
            "preLaunchTask": "C++ 빌드 (build_win)"
        },
        {
            "name": "🧪 C++ TRADE — 모의투자",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Quant/build_win/quant_trader.exe",
            "args": ["${workspaceFolder}/Quant/config/config_paper.json"],
            "cwd": "${workspaceFolder}/Quant/build_win",
            "console": "integratedTerminal",
            "preLaunchTask": "C++ 빌드 (build_win)"
        },
        {
            "name": "🔍 백테스팅 (2025-H1)",
